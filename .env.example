# Facebook Graph API & Meta Webhook Configuration
PORT=3000

# Meta Webhook Verification Token (Any secret string chosen by you)
FB_VERIFY_TOKEN=MY_FB_SECRET_VERIFY_TOKEN_123

# Facebook Page Access Token (Generated from developers.facebook.com)
FB_PAGE_ACCESS_TOKEN=your_page_access_token_here

# Facebook App Secret
FB_APP_SECRET=your_facebook_app_secret_here
